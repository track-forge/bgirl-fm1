+} bg_bus = {.owner=-1, .carrier=-1};
+static void bg_capture_begin(uint32_t n)
+{
+    int owner=-1,carrier=-1; uint32_t k, signature;
+    for(k=0;k<NPART;k++)
+        if(trk[k].engine==13 && trk[k].p[P_VCARR]) { owner=(int)k; break; }
+    if(owner>=0) {
+        carrier=trk[owner].p[P_VCARR]-1;
